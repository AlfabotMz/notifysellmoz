# ==========================================
# NotifySell Moz - Variáveis de Ambiente
# ==========================================

# 1. Base de Dados
# Local (Prisma SQLite):
DATABASE_URL="file:./dev.db"
# Produção / Docker (PostgreSQL) — altere também o provider em prisma/schema.prisma:
# DATABASE_URL="postgresql://notifysell:secret123@localhost:5432/notifysellmoz?schema=public"

# 2. Segurança e Sessão
# Segredo para assinatura de tokens de sessão JWT (gere com: openssl rand -base64 32)
AUTH_SECRET="your_secure_auth_session_secret_min_32_characters_123456"

# Chave simétrica AES-256 para encriptar tokens Shopify e API Keys em repouso
# (Gere com: openssl rand -hex 32)
ENCRYPTION_KEY="your_secure_encryption_key_32_bytes_hex_or_string"

# URL base pública da aplicação (HTTPS em produção; ngrok em dev). Sem barra no fim.
APP_URL="http://localhost:3000"

# 3. Credenciais da Aplicação Shopify Partner
# Obtidas em: Shopify Partners > Apps > Criar app
SHOPIFY_API_KEY="your_shopify_client_api_key"
SHOPIFY_API_SECRET="your_shopify_client_api_secret"
# Scopes mínimos para receber encomendas. write_orders só é necessário se for alterar encomendas.
SHOPIFY_SCOPES="read_orders,read_products,read_customers"

# 4. Fila Assíncrona Redis (obrigatório)
# Usado pelo BullMQ para processar notificações WhatsApp dos webhooks Shopify.
# Sem REDIS_URL os jobs não são processados. Com docker compose: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# 5. Evolution API (WhatsApp)
# URL do seu servidor Evolution (local Docker na porta 8080, ou instância cloud/Render).
EVOLUTION_DEFAULT_BASE_URL="http://localhost:8080"

# API Key global da Evolution API.
# No docker-compose local corresponde a AUTHENTICATION_API_KEY (ex.: evolution_global_secret_key_12345).
# No Render/cloud, use o valor de AUTHENTICATION_API_KEY desse servidor.
# Pode colar uma chave por loja na UI; se este env estiver definido, a UI pode deixá-lo vazio.
EVOLUTION_API_KEY="evolution_global_secret_key_12345"

# 6. Modo n8n (Opcional — URL por loja também pode ser definida na UI)
N8N_BASE_URL="http://localhost:5678"
